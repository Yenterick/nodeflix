{
  "name": "nodeflix-cdn-app",
  "version": "3.0.0",
  "description": "Content distribution network app for Nodeflix.",
  "keywords": [
    "cdn",
    "hls",
    "nodeflix",
    "desktop"
  ],
  "license": "ISC",
  "author": "Yenterick",
  "type": "commonjs",
  "main": "./src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.mediaprocessor.nodeflix",
    "productName": "Nodeflix Media Processor",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "public/assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/assets"
    }
  },
  "devDependencies": {
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "electron": "^41.1.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "mongoose": "^9.3.3",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  }
}
